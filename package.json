{
  "name": "rove-transit",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test --test-reporter=spec test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "check-secrets": "node --env-file-if-exists=.env scripts/check-secrets.mjs",
    "audit-data": "node scripts/audit-gtfs.mjs",
    "verify-realtime": "node scripts/verify-realtime.mjs",
    "verify-routing": "node scripts/verify-routing.mjs",
    "configure-511": "./scripts/configure-511-key.sh",
    "refresh-data": "./scripts/refresh-data.sh",
    "otp:setup": "./scripts/otp/setup-otp.sh",
    "otp:build": "./scripts/otp/build-graph.sh",
    "otp:start": "./scripts/otp/start-otp.sh",
    "places:build": "python3 scripts/places/build_places.py data/osm/norcal-latest.osm.pbf data/places/bay-area-places.sqlite",
    "verify-places": "node scripts/verify-places.mjs",
    "rove": "./scripts/start-rove.sh",
    "otp:stop": "./scripts/otp/stop-otp.sh",
    "verify-all": "./scripts/verify-all.sh",
    "verify-scenarios": "node scripts/verify-scenarios.mjs"
  },
  "dependencies": {
    "gtfs-realtime-bindings": "^1.1.1"
  },
  "devDependencies": {
    "graphql": "^16.9.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
