{
  "version": 2,
  "functions": {
    "api/v2/experimental-plan.mjs": {
      "includeFiles": "public/data/schedule/**",
      "maxDuration": 30
    },
    "api/v2/plan.mjs": {
      "includeFiles": "public/data/schedule/**",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/v2/experimental-plan",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/public/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "outputDirectory": "site"
}